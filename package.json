{
  "name": "bookleaf-platform",
  "version": "1.0.0",
  "description": "BookLeaf Publishing Author Support & Communication Portal",
  "main": "server/index.js",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "seed": "node server/scripts/seed.js",
    "test": "echo \"Ready for testing\" && exit 0"
  },
  "keywords": [
    "bookleaf",
    "publishing",
    "support",
    "ai",
    "portal"
  ],
  "author": "BookLeaf Engineering Candidate",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
