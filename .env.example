# BookLeaf Publishing - Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=bookleaf_jwt_super_secure_secret_key_change_in_production_2026

# Database Path (defaults to ./bookleaf.db in root)
DB_PATH=./bookleaf.db

# AI Provider Configuration (Optional)
# If provided, the system uses live LLM models.
# If omitted or unavailable, the system automatically and gracefully falls back to the
# BookLeaf Knowledge-Base Grounded Rule Engine with zero downtime or degradation.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client Base URL (for CORS if running on separate port in dev)
CLIENT_URL=http://localhost:5173
